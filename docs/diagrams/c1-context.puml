@startuml c1-context
!include <C4/C4_Context>

title System Context — Credential Broker at an Inspected Trust Boundary

AddElementTag("highzone", $bgColor="#EEF3FA", $borderColor="#4472A8")
AddElementTag("lowzone",  $bgColor="#F3F1EE", $borderColor="#7A7367")
AddElementTag("hostile",  $bgColor="#F7F3E8", $borderColor="#B08A3E")

Person(operator, "Operator / Control Plane", "A human, or an automation control plane acting for one, in the identity zone. Needs to manage a device it cannot hold the password for.")

System_Ext(idp, "Identity Provider", "Issues short-lived, audience-bound access tokens. The only authority for who the caller is.", $tags="highzone")

System_Ext(inspector, "Monitor (inspecting middlebox)", "Terminates TLS and inspects all traffic between zones. Forwards full packet captures to a store that is retained indefinitely and cannot be altered. Assumed hostile-capable.", $tags="hostile")

System(broker, "Credential Broker", "Deployed INSIDE the credential zone. Authorises the human, retrieves the credential locally, performs the target's login, and returns a capability — never a secret.", $tags="lowzone")

System_Ext(vault, "Secret Store", "Holds the long-lived target credentials. Reachable only from within the credential zone.", $tags="lowzone")

System_Ext(target, "Target System", "Vendor appliance, network device or COTS software. Speaks only its own native authentication.", $tags="lowzone")

Rel(operator, inspector, "Request + short-lived access token", "HTTPS")
Rel(inspector, broker, "Forwarded. Only a token is ever visible here.", "HTTPS")
Rel(broker, idp, "Validates token signature and claims", "JWKS")
Rel(broker, vault, "Authorises THIS human, then reads the credential", "HTTPS — never crosses the boundary")
Rel(broker, target, "Native login using the credential", "stays inside the zone")
Rel(broker, operator, "Capability: subject-bound, destination-bound, expiring", "HTTPS")

SHOW_LEGEND()
@enduml
